{
  "appId": "com.gasstation.manager",
  "productName": "Gas Station Manager",
  "copyright": "Copyright © 2026",
  "directories": {
    "output": "dist-electron",
    "buildResources": "electron"
  },
  "files": [
    "electron/main.js",
    "electron/assets/**/*"
  ],
  "extraResources": [
    {
      "from": ".next/standalone",
      "to": "app"
    },
    {
      "from": ".next/static",
      "to": "app/.next/static"
    },
    {
      "from": "public",
      "to": "app/public"
    },
    {
      "from": "db",
      "to": "app/db"
    },
    {
      "from": "prisma",
      "to": "app/prisma"
    }
  ],
  "asar": true,
  "asarUnpack": [
    "**/*.node",
    "**/prisma/**"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "electron/assets/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Gas Station Manager",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true,
    "installerIcon": "electron/assets/icon.png",
    "uninstallerIcon": "electron/assets/icon.png",
    "installerHeaderIcon": "electron/assets/icon.png"
  },
  "mac": {
    "target": ["dmg"],
    "icon": "electron/assets/icon.png",
    "category": "public.app-category.business"
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "electron/assets/icon.png",
    "category": "Office"
  }
}
